<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quotes Gallery</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page">
        <header class="page-header">
            <h1>Quotes Gallery</h1>
            <p>Collect and share the words that inspire you.</p>
        </header>

        <section class="card">
            <form class="quote-form" method="POST">
                <input type="text" name="quote" placeholder="Enter a quote" required>
                <input type="text" name="author" placeholder="Author">
                <input type="text" name="source" placeholder="Source" maxlength="255">
                <input type="text" name="tags" placeholder="Tags (comma-separated, e.g. wisdom, life)">
                <button type="submit">Add Quote</button>
            </form>
        </section>

        <section class="card">
            <form class="quote-form" method="GET" action="/">
                <input type="text" name="source" placeholder="Filter by source" value="<%= sourceFilter %>" maxlength="255">
                <input type="text" name="tag" placeholder="Filter by tag" value="<%= tagFilter %>" maxlength="100">
                <button type="submit">Filter</button>
                <% if (sourceFilter || tagFilter) { %>
                    <a href="/">Clear filter</a>
                <% } %>
            </form>
        </section>

        <section class="card">
            <% if (quotes.length === 0) { %>
                <% if (sourceFilter || tagFilter) { %>
                    <p class="empty-state">No quotes found for the selected filters.</p>
                <% } else { %>
                    <p class="empty-state">No quotes yet — be the first to add one!</p>
                <% } %>
            <% } else { %>
                <ul class="quote-list">
                    <% quotes.forEach(function(quote) { %>
                        <li class="quote-item">
                            <p class="quote-text">&ldquo;<%= quote.quote %>&rdquo;</p>
                            <p class="quote-author">&mdash; <%= quote.author || "Unknown" %></p>
                            <% if (quote.source) { %>
                                <p class="quote-source">Source: <%= quote.source %></p>
                            <% } %>
                            <% if (quote.tags && quote.tags.length > 0) { %>
                                <p class="quote-tags">Tags: <%= quote.tags.join(", ") %></p>
                            <% } %>
                            <form class="quote-delete-form" method="POST" action="/quotes/<%= quote.id %>/delete">
                                <button type="submit">Delete</button>
                            </form>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>
    </div>
</body>
</html>
